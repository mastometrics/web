---
import { Image } from "astro:assets";
import Base from "~/layouts/Base.astro";
import Footer from "~/components/astro/Footer.astro";
import FooterCredits from "~/components/astro/FooterCredits.astro";
import { FeatureCard } from "~/components/Home/FeatureCard";
import { LoginForm } from "~/components/LoginForm";
import graphBgPattern from "~/assets/graph-bg.svg";
import screenshotDark from "~/assets/screenshot-dark.png";
import logo3d from "~/assets/3d-logo.svg";
import logo from "~/assets/logo.svg";

const isLoggedIn = !!Astro.locals.user;
const slogan = "Track the growth of your Mastodon Account";
const mask = `linear-gradient(90deg, rgba(0,0,0,0.00) 0%, rgba(0,0,0,0.00) 2%, rgba(0,0,0,0.94) 20%, #000000 25%, #000000 75%, rgba(0,0,0,0.94) 80%, rgba(0,0,0,0.00) 98%, rgba(0,0,0,0.00) 100%)`;
const guarantees = ["No email required.", "No write permissions asked."];
---

<Base title="MastoMetrics - Analytics for Mastodon" description={slogan} bodyClass="bg-[#0B0C32]">
  <div class="relative min-h-screen bg-[#0B0C32] font-display">
    <!-- Background pattern -->
    <div class="absolute top-0 mx-auto h-full min-h-screen w-full overflow-hidden" aria-hidden="true">
      <div class="top-0 z-0 mx-auto aspect-[2/1] w-full max-w-[120rem] origin-top scale-125 bg-radial-[farthest-side_at_top] from-[#4A4DED] to-[#0B0C32]"></div>
    </div>
    <div class="absolute mx-auto h-full w-full overflow-hidden" aria-hidden="true">
      <div class="absolute left-[-20%] right-[-50%] top-[150vw] z-0 w-[200%] overflow-x-clip sm:top-[45rem] lg:-left-4 lg:-right-4 lg:top-[55rem] lg:h-[60rem] lg:w-full 2xl:top-[62rem]">
        <img
          src={graphBgPattern.src}
          class="mx-auto"
          style={{ "mask-image": mask, "-webkit-mask-image": mask }}
          alt=""
        />
      </div>
    </div>

    <div class="container relative mx-auto min-h-screen max-w-4xl 2xl:max-w-6xl">
      <!-- Nav -->
      <div class="z-10 flex h-20 flex-row items-center justify-center px-4 sm:px-8">
        <div class="relative flex items-center">
          <img src={logo.src} alt="MastoMetrics logo" class="mr-2 h-10 w-14 object-cover object-left" />
          <div class="flex flex-col gap-x-3 sm:flex-row sm:items-center">
            <p class="text-base font-extrabold text-white sm:text-2xl">MastoMetrics</p>
            <p class="-mt-0.5 text-xs font-semibold text-mastodon-purple-200/80 sm:mt-1 sm:text-lg">
              Analytics for Mastodon
            </p>
          </div>
        </div>
        <div class="flex-auto"></div>
        <div>
          <a
            href={isLoggedIn ? "/dashboard" : "/auth/login"}
            class="rounded-lg border border-mastodon-purple-400 bg-linear-to-b from-mastodon-purple-600/10 to-mastodon-purple-800/50 px-6 py-2 font-semibold text-mastodon-purple-100 shadow-[0_1px_4px_1px_rgba(0,0,0,0.09),inset_0_1px_2px_0_rgba(0,0,0,0.18)] transition-all duration-75 hover:border-mastodon-purple-300 hover:from-mastodon-purple-600/40 hover:to-mastodon-purple-700/70 hover:shadow-[0_1px_7px_2px_rgba(0,0,0,0.1),inset_0_1px_2px_0_rgba(0,0,0,0.18)] focus:outline-hidden focus-visible:border-mastodon-purple-100 active:from-mastodon-purple-700/20 active:to-mastodon-purple-900/40 active:shadow-none active:duration-0"
          >
            {isLoggedIn ? "Dashboard" : "Sign in"}
          </a>
        </div>
      </div>

      <!-- Hero -->
      <div class="flex flex-col-reverse items-center justify-center px-4 sm:px-8">
        <div class="-mt-20 flex flex-col items-center justify-center sm:-mt-32">
          <div class="z-20 -my-3">
            <img src={logo3d.src} class="w-40 sm:w-60" alt="" />
          </div>
          <div class="text-center text-2xl font-extrabold text-white sm:text-4xl">MastoMetrics</div>
          <div class="mt-2 text-center text-base font-medium text-mastodon-purple-200 sm:text-2xl">{slogan}</div>
        </div>
        <div class="aspect-video w-full rounded-xs bg-black shadow-2xl">
          <Image
            src={screenshotDark}
            widths={[640, 960, 1280, 1920]}
            sizes="(min-width: 1536px) 72rem, (min-width: 896px) 56rem, 100vw"
            class="aspect-[4/5] w-full object-cover object-top sm:aspect-[4/3]"
            alt="Screenshot of MastoMetrics Dashboard"
            loading="eager"
          />
        </div>
      </div>

      <!-- Features -->
      <div class="my-24 grid gap-6 px-4 sm:px-8 lg:grid-cols-3">
        <FeatureCard client:visible title="Free">
          MastoMetrics is free to use for any number of accounts.
        </FeatureCard>
        <FeatureCard client:visible title="Simple">
          Track follower progress over time and see your most engaging posts.
        </FeatureCard>
        <FeatureCard client:visible title="Fair">
          We don’t need your email and only store public data.
        </FeatureCard>
      </div>

      {!isLoggedIn && (
        <div class="my-24 flex flex-col items-center justify-center px-4 sm:px-8">
          <div class="text-lg font-bold text-white">Enter your Mastodon username to get started</div>
          <div class="mt-2 flex flex-wrap gap-2 text-base font-medium text-mastodon-purple-200">
            {guarantees.map((g) => (
              <p>{g}</p>
            ))}
            <a href="/faq" class="text-mastodon-purple-400 transition hover:text-white">
              Learn more →
            </a>
          </div>
          <div class="mt-6 flex w-full max-w-xl flex-col items-center justify-center">
            <LoginForm client:load cta="Sign up" class="w-full" />
          </div>
        </div>
      )}
      <Footer />
      <FooterCredits />
    </div>
  </div>
</Base>
