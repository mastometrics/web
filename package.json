{
  "name": "mastometrics",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "prisma generate && astro build && npm run build:worker",
    "build:worker": "esbuild src/worker.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/worker.mjs",
    "start": "node scripts/start.mjs",
    "start:app": "node scripts/start.mjs --app",
    "start:worker": "node scripts/start.mjs --worker",
    "check": "astro check",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "format": "prettier --write .",
    "postinstall": "prisma generate",
    "db:seed": "tsx scripts/seed.ts"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "prettier": {
    "printWidth": 120,
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-tailwindcss"
    ],
    "trailingComma": "es5"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.8",
    "@astrojs/solid-js": "^7.1.0",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@kobalte/core": "^0.13.14",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "astro": "^7.4.0",
    "chart.js": "^4.5.1",
    "cron": "^4.4.0",
    "dotenv": "^18.0.8",
    "linkedom": "^0.18.13",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "sharp": "^0.35.5",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@iconify-json/tabler": "^1.2.42",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "unplugin-icons": "^24.0.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  }
}
