# Copy this file to `.env` and fill in the values.

# --- Required ------------------------------------------------------------------

# PostgreSQL connection string (not needed with docker compose, which sets it from POSTGRES_PASSWORD)
# Managed databases: append `&uselibpqcompat=true` or `&sslrootcert=...` to `sslmode=require`, and set
# `connection_limit` (default 10 per process) to stay below the connection limit, see Database in the README
DATABASE_URL="postgresql://mastometrics:password@localhost:5432/mastometrics"

# Secret used to sign session cookies, generate one with `openssl rand -base64 32`
SESSION_SECRET=""

# Public URL of your deployment, used for the OAuth redirect when signing in with Mastodon
SITE_URL="http://localhost:4321"

# Database password, only used by docker compose
POSTGRES_PASSWORD=""

# --- Optional ------------------------------------------------------------------

# Name used when registering the app on Mastodon instances
# APP_NAME="MastoMetrics"

# Mastodon account used for support and contact links
# CONTACT_HANDLE="MastoMetrics@mas.to"

# Show the ko-fi donation banner on the dashboard
# SHOW_DONATION_BANNER="false"

# Port to listen on (default 4321) and host (use 0.0.0.0 to listen on all interfaces)
# PORT=4321
# HOST=127.0.0.1

# Which processes `npm start` runs: "default" (web app + worker), "app" or "worker"
# DEPLOYMENT_TYPE="default"

# debug, info, warning or error
# LOG_LEVEL="info"

# Disable sign ins, the dashboard and the worker during maintenance
# MAINTENANCE_MODE="false"

# --- Worker --------------------------------------------------------------------

# Run the sync job every N minutes, or with a custom cron schedule
# WORKER_SYNC_INTERVAL_MINS=2
# WORKER_SYNC_CRON_SCHEDULE="*/2 * * * *"

# Accounts are synced again after N minutes
# WORKER_SYNC_OUTDATED_MINS=45

# Number of recent statuses to update per sync, ideally a multiple of 40
# WORKER_SYNC_MAX_STATUS_COUNT=120

# Max fraction of accounts synced per job, to spread out load
# WORKER_SYNC_MAX_SPIKE=0.067

# Warnings kept per account, and warnings within 24 hours after which syncing an account is suspended
# WORKER_MAX_WARNINGS_LOGGED=15
# WORKER_SUSPEND_IMPORT_AFTER_WARNINGS=10

# Daily delete the data of accounts that revoked access more than 30 days ago (see the privacy policy)
# WORKER_PURGE_REVOKED_ACCOUNTS="true"
