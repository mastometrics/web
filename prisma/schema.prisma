generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["extendedWhereUnique", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

model Account {
  id                Int      @id @default(autoincrement())
  instance          String   @db.Citext
  username          String   @unique @db.Citext
  displayName       String?
  instanceAccountId String
  followersCount    Int?
  followingCount    Int?
  statusesCount     Int?
  bot               Boolean?
  discoverable      Boolean?
  noindex           Boolean?
  locked            Boolean?
  avatar            String?
  lastIndex         DateTime @default(now()) @updatedAt
  tracking          Boolean  @default(false)
  raw               Json?
  Statuses          Status[]
  Following         Follow[] @relation("AccountFollowing")
  Followers         Follow[] @relation("AccountFollowers")
  Metrics           Metric[]
  User              User[]

  @@map("accounts")
}

model Metric {
  id          Int      @id @default(autoincrement())
  accountId   Int
  timestamp   DateTime
  followers   Int?
  following   Int?
  statuses    Int?
  engagements Int?
  replies     Int?
  boosts      Int?
  favorites   Int?
  Account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([accountId, timestamp])
  @@map("metrics")
}

model Status {
  id               Int      @id @default(autoincrement())
  statusUri        String   @unique
  url              String?
  content          String
  isReblog         Boolean?
  repliesCount     Int?
  accountId        Int
  boostsCount      Int?
  favoritesCount   Int?
  publishedAt      DateTime
  lastIndex        DateTime @default(now()) @updatedAt
  raw              Json?
  engagementsCount Int?
  Account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("statuses")
}

model Follow {
  id          Int      @id @default(autoincrement())
  accountId   Int
  followingId Int
  createdAt   DateTime @default(now())
  lastIndex   DateTime @default(now()) @updatedAt
  Account     Account  @relation("AccountFollowing", fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Following   Account  @relation("AccountFollowers", fields: [followingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([accountId, followingId])
  @@map("follows")
}

model Instance {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  host         String   @unique @db.Citext
  name         String
  clientId     String?
  clientSecret String?
  token        String?
  raw          Json?
  rawClient    Json?
  Users        User[]

  @@map("instances")
}

model User {
  id         Int      @id @default(autoincrement())
  instanceId Int
  accountId  Int      @unique
  scopes     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  token      String
  lastSeen   DateTime @default(now())
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([instanceId, accountId])
  @@map("users")
}
