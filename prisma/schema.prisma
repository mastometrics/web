generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

model Account {
  id                Int           @id @default(autoincrement())
  instance          String        @db.Citext
  username          String        @unique @db.Citext
  displayName       String?
  instanceAccountId String
  followersCount    Int?
  followingCount    Int?
  statusesCount     Int?
  bot               Boolean?
  discoverable      Boolean?
  noindex           Boolean?
  locked            Boolean?
  avatar            String?
  lastIndex         DateTime      @default(now()) @updatedAt
  tracking          Boolean       @default(false)
  metadata          Json?
  raw               Json?
  Statuses          Status[]
  Metrics           Metric[]
  User              User[]
  Interactions      Interaction[]

  @@index([username])
  @@index([lastIndex])
  @@map("accounts")
}

model Metric {
  id          Int      @id @default(autoincrement())
  accountId   Int
  timestamp   DateTime
  followers   Int?
  following   Int?
  statuses    Int?
  engagements Int?
  replies     Int?
  boosts      Int?
  favorites   Int?
  Account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([accountId, timestamp])
  @@index([accountId, timestamp])
  @@index([timestamp])
  @@index([accountId])
  @@map("metrics")
}

model Status {
  id               Int      @id @default(autoincrement())
  statusUri        String   @unique
  url              String?
  content          String
  isReblog         Boolean?
  repliesCount     Int?
  accountId        Int
  boostsCount      Int?
  favoritesCount   Int?
  publishedAt      DateTime
  lastIndex        DateTime @default(now()) @updatedAt
  raw              Json?
  metadata         Json?
  engagementsCount Int?
  Account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([accountId])
  @@index([publishedAt])
  @@index([engagementsCount])
  @@index([boostsCount])
  @@index([favoritesCount])
  @@index([repliesCount])
  @@index([isReblog])
  @@index([statusUri])
  @@map("statuses")
}

// Cache accounts for users of the same instance, i.e. foo@[mas.to] and bar@[mas.to] share the same cache for otheruser@otherinstance.com. 
// But baz@[other.instance.social] has their own cache. This is also due to where cached/static avatars are stored

model CachedAccount {
  id                Int      @id @default(autoincrement())
  instance          String   @db.Citext
  username          String   @db.Citext
  hostInstance      String   @db.Citext
  instanceAccountId String
  displayName       String?
  followersCount    Int?
  followingCount    Int?
  statusesCount     Int?
  avatar            String?
  lastIndex         DateTime @default(now()) @updatedAt

  @@unique([username, hostInstance])
  @@index([username, hostInstance])
  @@index([instanceAccountId])
  @@map("cached_accounts")
}

model Interaction {
  id                Int       @id @default(autoincrement())
  accountId         Int
  username          String    @db.Citext
  type              String
  instanceAccountId String
  reach             Int?
  statusUri         String?
  timestamp         DateTime? @default(now())
  Account           Account   @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([username])
  @@index([type])
  @@index([accountId, username])
  @@index([statusUri])
  @@map("interactions")
}

model Instance {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  host         String   @unique @db.Citext
  name         String
  clientId     String?
  clientSecret String?
  token        String?
  raw          Json?
  metadata     Json?
  rawClient    Json?
  Users        User[]

  @@map("instances")
}

model User {
  id         Int      @id @default(autoincrement())
  instanceId Int
  accountId  Int      @unique
  scopes     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  token      String
  lastSeen   DateTime @default(now())
  roles      String[] @default([])
  metadata   Json?
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([instanceId, accountId])
  @@index([accountId])
  @@map("users")
}
